#. Plugin Name of the plugin
#: od-chotto-benri.php
msgid "OD Chotto Benri"
msgstr "OD Chotto Benri"

#. Description of the plugin
#: od-chotto-benri.php
msgid "A collection of small features that make WordPress a little more convenient."
msgstr "WordPressを少し便利にする小さな機能をまとめたプラグインです。"

#: includes/class-od-chotto-benri-settings.php
msgid "Features to use"
msgstr "利用する機能"

#: includes/class-od-chotto-benri-settings.php
msgid "Select the features you want to use. Newly added features are enabled by default."
msgstr "使用する機能を選択してください。新しく追加された機能は初期状態で有効になります。"

#: assets/js/conditional-modified-date.js
#: includes/features/conditional-modified-date/class-od-chotto-benri-conditional-modified-date-feature.php
msgid "Conditional modified date"
msgstr "条件付き更新日"

#: assets/js/conditional-modified-date.js
#: includes/features/conditional-modified-date/class-od-chotto-benri-conditional-modified-date-feature.php
msgid "Display the modified date only when it differs from the published date."
msgstr "投稿日と更新日が異なる日付の場合だけ更新日を表示します。"

#: assets/js/conditional-modified-date.js
msgid "Updated:"
msgstr "更新："

#: includes/features/inline-attributes/class-od-chotto-benri-inline-attributes-feature.php
msgid "RichText inline attributes"
msgstr "RichTextインライン属性"

#: includes/features/inline-attributes/class-od-chotto-benri-inline-attributes-feature.php
msgid "Add CSS classes, accessibility attributes, and language metadata to selected RichText."
msgstr "選択したRichTextにCSSクラス、アクセシビリティ属性、言語情報を追加します。"

#: src/edit.js src/index.js
msgid "Inline attributes"
msgstr "インライン属性"

#: src/edit.js
msgid "CSS classes"
msgstr "CSSクラス"

#: src/edit.js
msgid "Separate multiple classes with spaces."
msgstr "複数のクラスは半角スペースで区切ります。"

#: src/edit.js
msgid "Enter valid CSS class names separated by spaces."
msgstr "有効なCSSクラス名を半角スペースで区切って入力してください。"

#: src/edit.js
msgid "Accessibility"
msgstr "アクセシビリティ"

#: src/edit.js
msgid "Hide from assistive technologies"
msgstr "支援技術から非表示"

#: src/edit.js
msgid "Use this for decorative text that does not need to be announced."
msgstr "装飾目的など、読み上げる必要のない文字に使用します。"

#: src/edit.js
msgid "Accessible label"
